<footer class="site-footer" style="--footer-background: {{ section.settings.background_color }}; --footer-text-color: {{ section.settings.text_color }};">
  <div class="footer-gradient" aria-hidden="true"></div>
  <div class="page-width footer-main">
    {% if section.settings.show_brand %}
      <div class="footer-brand">
        {% if section.settings.logo != blank %}
          <a class="footer-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {{ section.settings.logo | image_url: width: 420 | image_tag: widths: '140, 210, 280, 420', loading: 'lazy', alt: shop.name }}
          </a>
        {% endif %}
        <h2>{{ section.settings.brand_heading | default: shop.name | escape }}</h2>
        {% if section.settings.brand_text != blank %}<p>{{ section.settings.brand_text | escape }}</p>{% endif %}
        <div class="footer-social-links">
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">Instagram</a>{% endif %}
          {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">Facebook</a>{% endif %}
          {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">TikTok</a>{% endif %}
          {% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" aria-label="YouTube">YouTube</a>{% endif %}
        </div>
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'menu' and block.settings.menu != blank %}
        <nav class="footer-menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <ul>
            {% for link in block.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    {% endfor %}

    {% if section.settings.show_newsletter %}
      <div class="footer-newsletter">
        <h2>{{ section.settings.newsletter_heading | escape }}</h2>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Correo electrónico</label>
          <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ section.settings.email_placeholder | escape }}" required>
          <button class="button" type="submit">{{ section.settings.newsletter_button | escape }}</button>
          {% if form.posted_successfully? %}<p class="form-status" role="status">{{ section.settings.success_message | escape }}</p>{% endif %}
          {% if form.errors %}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}
      </div>
    {% endif %}
  </div>

  <div class="page-width footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_text | escape }}</p>
    {% if section.settings.show_payment_methods and shop.enabled_payment_types.size > 0 %}
      <div class="footer-payment-methods" aria-label="Métodos de pago">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#4D0E13" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#EEE4DA" },
    { "type": "checkbox", "id": "show_brand", "label": "Mostrar presentación", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logotipo del pie de página" },
    { "type": "text", "id": "brand_heading", "label": "Nombre de marca", "default": "Nuestra tienda" },
    { "type": "textarea", "id": "brand_text", "label": "Texto de presentación", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
    { "type": "url", "id": "instagram_url", "label": "Enlace de Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Enlace de Facebook" },
    { "type": "url", "id": "tiktok_url", "label": "Enlace de TikTok" },
    { "type": "url", "id": "youtube_url", "label": "Enlace de YouTube" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar formulario de suscripción", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Título de suscripción", "default": "Recibe nuestras novedades" },
    { "type": "text", "id": "email_placeholder", "label": "Texto de campo de correo", "default": "Tu correo electrónico" },
    { "type": "text", "id": "newsletter_button", "label": "Texto del botón", "default": "Suscribirme" },
    { "type": "text", "id": "success_message", "label": "Confirmación de suscripción", "default": "Gracias por suscribirte." },
    { "type": "text", "id": "copyright_text", "label": "Texto junto al copyright", "default": "Todos los derechos reservados." },
    { "type": "checkbox", "id": "show_payment_methods", "label": "Mostrar métodos de pago disponibles", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú del pie",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Información" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Pie de página", "blocks": [{ "type": "menu" }, { "type": "menu" }] }]
}
{% endschema %}
