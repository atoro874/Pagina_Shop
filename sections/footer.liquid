<footer class="site-footer" style="--footer-background: {{ section.settings.background_color }}; --footer-text-color: {{ section.settings.text_color }};">
  <div class="footer-gradient" aria-hidden="true">
    <svg class="footer-wave" viewBox="0 0 1440 180" preserveAspectRatio="none" focusable="false">
      <defs>
        <linearGradient id="FooterWavePink-{{ section.id }}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#D99A9C"></stop>
          <stop offset="1" stop-color="#A65370"></stop>
        </linearGradient>
        <linearGradient id="FooterWaveAccent-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#C8A49F"></stop>
          <stop offset="1" stop-color="#8D3857"></stop>
        </linearGradient>
      </defs>
      <path class="footer-wave-back" fill="url(#FooterWavePink-{{ section.id }})" d="M0 91 C70 91 79 74 133 74 C191 74 202 106 258 106 C322 106 331 50 397 50 C462 50 470 94 532 94 C598 94 613 69 675 69 C740 69 754 110 821 110 C884 110 900 61 969 61 C1031 61 1046 91 1107 91 C1171 91 1185 41 1251 41 C1320 41 1336 88 1440 76 V180 H0 Z"></path>
      <path class="footer-wave-front" fill="url(#FooterWaveAccent-{{ section.id }})" d="M0 104 C64 104 86 82 145 82 C208 82 214 117 278 117 C340 117 358 72 420 72 C485 72 500 111 563 111 C627 111 643 84 707 84 C771 84 788 121 850 121 C915 121 931 78 995 78 C1058 78 1075 111 1138 111 C1204 111 1220 62 1284 62 C1344 62 1371 100 1440 91 V180 H0 Z"></path>
      <path class="footer-wave-base" d="M0 122 C72 122 90 99 155 99 C222 99 234 132 300 132 C368 132 380 94 448 94 C514 94 530 128 596 128 C663 128 678 103 744 103 C812 103 827 137 895 137 C963 137 979 97 1046 97 C1112 97 1127 127 1195 127 C1264 127 1280 83 1347 83 C1389 83 1414 100 1440 104 V180 H0 Z"></path>
    </svg>
  </div>
  <div class="page-width footer-main">
    {% if section.settings.show_brand %}
      <div class="footer-brand">
        {% if section.settings.logo != blank %}
          <a class="footer-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {{ section.settings.logo | image_url: width: 420 | image_tag: widths: '140, 210, 280, 420', loading: 'lazy', alt: shop.name }}
          </a>
        {% endif %}
        <h2>{{ section.settings.brand_heading | default: shop.name | escape }}</h2>
        {% if section.settings.brand_text != blank %}<p>{{ section.settings.brand_text | escape }}</p>{% endif %}
        <div class="footer-social-links">
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">Instagram</a>{% endif %}
          {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">Facebook</a>{% endif %}
          {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">TikTok</a>{% endif %}
          {% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" aria-label="YouTube">YouTube</a>{% endif %}
        </div>
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'menu' and block.settings.menu != blank %}
        <nav class="footer-menu" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading | escape }}</h2>
          <ul>
            {% for link in block.settings.menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    {% endfor %}

  </div>

  <div class="page-width footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.copyright_text | escape }}</p>
    {% if section.settings.show_payment_methods %}
      <div class="footer-payment-methods" aria-label="Métodos de pago aceptados">
        <span class="footer-payment-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="6" width="19" height="13" rx="2"></rect><path d="M2.5 10h19M7 15h3"></path></svg>
          Efectivo / Pago contra entrega (COD)
        </span>
        <span class="footer-payment-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9h18M5 9v9m4-9v9m6-9v9m4-9v9M2 21h20M12 3 2 8h20L12 3Z"></path></svg>
          Transferencias bancarias
        </span>
        <span class="footer-payment-badge footer-payment-card" aria-label="Visa">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
          VISA
        </span>
        <span class="footer-payment-badge footer-payment-card" aria-label="Mastercard">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
          Mastercard
        </span>
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#4D0E13" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#EEE4DA" },
    { "type": "checkbox", "id": "show_brand", "label": "Mostrar presentación", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logotipo del pie de página" },
    { "type": "text", "id": "brand_heading", "label": "Nombre de marca", "default": "Nuestra tienda" },
    { "type": "textarea", "id": "brand_text", "label": "Texto de presentación", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
    { "type": "url", "id": "instagram_url", "label": "Enlace de Instagram" },
    { "type": "url", "id": "facebook_url", "label": "Enlace de Facebook" },
    { "type": "url", "id": "tiktok_url", "label": "Enlace de TikTok" },
    { "type": "url", "id": "youtube_url", "label": "Enlace de YouTube" },
    { "type": "text", "id": "copyright_text", "label": "Texto junto al copyright", "default": "Todos los derechos reservados." },
    { "type": "checkbox", "id": "show_payment_methods", "label": "Mostrar métodos de pago disponibles", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú del pie",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Información" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Pie de página", "blocks": [{ "type": "menu" }, { "type": "menu" }] }]
}
{% endschema %}
