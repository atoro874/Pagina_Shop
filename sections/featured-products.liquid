<section class="section featured-products" style="--products-background: {{ section.settings.background_color }}; --products-text: {{ section.settings.text_color }};">
  <div class="page-width">
    <header class="section-heading">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </header>

    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            <a class="product-card-image" href="{{ product.url }}">
              {% if product.featured_image != blank %}
                {% assign product_image_alt = product.featured_image.alt | default: product.title %}
                {{ product.featured_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 750, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: product_image_alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
            <div class="product-card-details">
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <p class="product-price">
                {% if product.price_varies %}{{ section.settings.price_from | escape }} {% endif %}
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
              </p>
              {% if product.available %}
                {% form 'product', product, class: 'product-card-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button class="button product-buy-button" type="submit">{{ section.settings.button_label | escape }}</button>
                {% endform %}
              {% else %}
                <button class="button product-buy-button" type="button" disabled>{{ section.settings.sold_out_label | escape }}</button>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and section.settings.collection.url != blank %}
        <div class="featured-products-all">
          <a class="button button--secondary" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label | escape }}</a>
        </div>
      {% endif %}
    {% else %}
      <div class="product-empty-state">
        <p>{{ section.settings.empty_message | escape }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lorem ipsum dolor sit amet" },
    { "type": "text", "id": "text", "label": "Descripción" },
    { "type": "collection", "id": "collection", "label": "Colección de productos" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Productos a mostrar", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar enlace a la colección", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto del enlace", "default": "Ver colección" },
    { "type": "text", "id": "button_label", "label": "Texto del botón de compra", "default": "Añadir al carrito" },
    { "type": "text", "id": "sold_out_label", "label": "Texto para producto agotado", "default": "Agotado" },
    { "type": "text", "id": "price_from", "label": "Texto para precio variable", "default": "Desde" },
    { "type": "text", "id": "empty_message", "label": "Mensaje sin colección seleccionada", "default": "Selecciona una colección para mostrar tus productos destacados." },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#EEE4DA" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#4D0E13" }
  ]
}
{% endschema %}
