<section
  id="HomeProduct-{{ section.id }}"
  class="product-page"
  style="--product-background: {{ section.settings.background_color }}; --product-text: {{ section.settings.text_color }}; --product-accent: {{ section.settings.accent_color }};"
>
  <div class="page-width">
    <div class="product-overview">
      <div class="product-gallery" data-product-gallery>
        {% assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' %}
        {% assign available_gallery_images = 0 %}
        {% for block in gallery_blocks %}
          {% if block.settings.image != blank %}
            {% assign available_gallery_images = available_gallery_images | plus: 1 %}
          {% endif %}
        {% endfor %}
        <div class="product-gallery-thumbnails" role="group" aria-label="Imágenes del producto">
          {% assign rendered_thumbnail_count = 0 %}
          {% for block in gallery_blocks %}
            {% if block.settings.image != blank %}
              {% assign gallery_alt = block.settings.alt | default: block.settings.image.alt | default: 'Lorem ipsum' %}
              <button
                class="product-thumbnail{% if rendered_thumbnail_count == 0 %} is-selected{% endif %}"
                type="button"
                data-product-thumbnail="{{ rendered_thumbnail_count }}"
                aria-label="Ver imagen {{ rendered_thumbnail_count | plus: 1 }} de {{ available_gallery_images }}"
                aria-pressed="{% if rendered_thumbnail_count == 0 %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: gallery_alt }}
              </button>
              {% assign rendered_thumbnail_count = rendered_thumbnail_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if available_gallery_images == 0 %}
            {% for image_index in (1..3) %}
              <button class="product-thumbnail{% if forloop.first %} is-selected{% endif %}" type="button" disabled aria-label="Imagen {{ forloop.index }}">
                {{ 'product-' | append: forloop.index | placeholder_svg_tag }}
              </button>
            {% endfor %}
          {% endif %}
        </div>

        <div class="product-gallery-stage">
          {% assign rendered_gallery_images = 0 %}
          {% for block in gallery_blocks %}
            {% if block.settings.image != blank %}
              {% assign gallery_alt = block.settings.alt | default: block.settings.image.alt | default: 'Lorem ipsum' %}
              {% assign image_loading = 'lazy' %}
              {% if rendered_gallery_images == 0 %}{% assign image_loading = 'eager' %}{% endif %}
              <div
                class="product-gallery-image"
                data-product-gallery-image="{{ rendered_gallery_images }}"
                {% if rendered_gallery_images > 0 %}hidden aria-hidden="true"{% else %}aria-hidden="false"{% endif %}
              >
                {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 1000px) 48vw, 100vw', loading: image_loading, alt: gallery_alt }}
              </div>
              {% assign rendered_gallery_images = rendered_gallery_images | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if rendered_gallery_images == 0 %}
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery-placeholder' }}
          {% endif %}
        </div>
      </div>

      <div class="product-summary">
        {% if section.settings.badge_text != blank %}
          <p class="product-badge">{{ section.settings.badge_text | escape }}</p>
        {% endif %}
        <h1>{{ section.settings.product_title | escape }}</h1>

        <div class="product-rating" aria-label="Calificación {{ section.settings.rating_score }} de 5; {{ section.settings.review_count | escape }}">
          <span class="product-rating-stars" aria-hidden="true">
            {% for star in (1..5) %}
              <span{% if star > section.settings.rating_score %} class="is-empty"{% endif %}>★</span>
            {% endfor %}
          </span>
          <span>{{ section.settings.rating_score }}/5 ({{ section.settings.review_count | escape }})</span>
        </div>

        <div class="product-price">
          <span>{{ section.settings.price_text | escape }}</span>
          {% if section.settings.compare_price_text != blank %}
            <s>{{ section.settings.compare_price_text | escape }}</s>
            <span class="product-discount">{{ section.settings.discount_label | escape }}</span>
          {% endif %}
        </div>

        <div class="product-introduction rte">{{ section.settings.introduction }}</div>

        <button class="button product-buy-button" type="button">
          {{ section.settings.buy_button_label | escape }}
        </button>

        <div class="product-service-points">
          {% for service_index in (1..3) %}
            {% assign service_title_key = 'service_' | append: service_index | append: '_title' %}
            {% assign service_text_key = 'service_' | append: service_index | append: '_text' %}
            <div class="product-service-point">
              <span class="product-service-icon" aria-hidden="true">
                {% case service_index %}
                  {% when 1 %}
                    <svg viewBox="0 0 24 24"><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8z"></path><circle cx="7" cy="19" r="2"></circle><circle cx="18" cy="19" r="2"></circle></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 24 24"><path d="M12 3 21 7v5c0 5-3.5 8-9 10-5.5-2-9-5-9-10V7l9-4Z"></path><path d="m8 12 3 3 5-6"></path></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 10h18M7 15h4"></path></svg>
                {% endcase %}
              </span>
              <span>
                <strong>{{ section.settings[service_title_key] | escape }}</strong>
                <span>{{ section.settings[service_text_key] | escape }}</span>
              </span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="product-information" data-product-tabs>
      <div class="product-tabs" role="tablist" aria-label="Información del producto">
        <button
          class="product-tab"
          id="HomeDetailsTab-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="HomeDetailsPanel-{{ section.id }}"
          data-product-tab="details"
        >{{ section.settings.details_tab_label | escape }}</button>
        <button
          class="product-tab"
          id="HomeMaterialsTab-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="HomeMaterialsPanel-{{ section.id }}"
          data-product-tab="materials"
        >{{ section.settings.materials_tab_label | escape }}</button>
      </div>

      <div
        class="product-tab-panel"
        id="HomeDetailsPanel-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="HomeDetailsTab-{{ section.id }}"
        data-product-panel="details"
        aria-hidden="false"
      >
        <div class="product-tab-copy rte">
          <h2>{{ section.settings.details_heading | escape }}</h2>
          {{ section.settings.details_content }}
        </div>
        <div class="product-tab-image">
          {% if section.settings.details_image != blank %}
            {{ section.settings.details_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', loading: 'lazy' }}
          {% else %}
            {{ 'product-2' | placeholder_svg_tag: 'product-tab-placeholder' }}
          {% endif %}
        </div>
      </div>

      <div
        class="product-tab-panel"
        id="HomeMaterialsPanel-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="HomeMaterialsTab-{{ section.id }}"
        data-product-panel="materials"
        aria-hidden="true"
        hidden
      >
        <div class="product-tab-copy rte">
          <h2>{{ section.settings.materials_heading | escape }}</h2>
          {{ section.settings.materials_content }}
        </div>
        <div class="product-tab-image">
          {% if section.settings.materials_image != blank %}
            {{ section.settings.materials_image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', loading: 'lazy' }}
          {% else %}
            {{ 'product-3' | placeholder_svg_tag: 'product-tab-placeholder' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="product-reviews" style="--reviews-background: {{ section.settings.reviews_background }}; --reviews-text: {{ section.settings.text_color }};">
  <div class="page-width">
    <header class="product-reviews-heading">
      <p class="product-eyebrow">{{ section.settings.reviews_eyebrow | escape }}</p>
      <h2>{{ section.settings.reviews_heading | escape }}</h2>
      {% if section.settings.reviews_subheading != blank %}
        <p>{{ section.settings.reviews_subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="product-reviews-grid">
      {% assign review_blocks = section.blocks | where: 'type', 'review' %}
      {% for block in review_blocks %}
        <article class="product-review-card" {{ block.shopify_attributes }}>
          <div class="product-review-stars" aria-label="Calificación {{ block.settings.rating }} de 5">
            {% for star in (1..5) %}
              <span aria-hidden="true"{% if star > block.settings.rating %} class="is-empty"{% endif %}>★</span>
            {% endfor %}
          </div>
          <p class="product-review-quote">{{ block.settings.quote | escape }}</p>
          <p class="product-review-author">{{ block.settings.author | escape }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="product-faq" style="--faq-background: {{ section.settings.faq_background }}; --faq-text: {{ section.settings.text_color }};">
  <div class="page-width">
    <h2>{{ section.settings.faq_heading | escape }}</h2>
    <div class="product-faq-list">
      {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}
      {% for block in faq_blocks %}
        <details class="product-faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="product-faq-answer rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% if section.settings.show_related_products %}
  <section class="related-products">
    <div class="page-width">
      <header class="related-products-heading">
        <h2>{{ section.settings.related_heading | escape }}</h2>
        {% if section.settings.related_link != blank %}
          <a href="{{ section.settings.related_link }}">{{ section.settings.related_link_label | escape }}</a>
        {% endif %}
      </header>
      <div class="related-products-grid">
        {% assign related_blocks = section.blocks | where: 'type', 'related_product' %}
        {% for block in related_blocks %}
          <article class="related-product-card" {{ block.shopify_attributes }}>
            {% assign recommendation_href = block.settings.link %}
            {% if block.settings.product != blank %}
              {% assign recommendation_href = block.settings.product.url %}
            {% endif %}
            {% if recommendation_href != blank %}<a class="related-product-link" href="{{ recommendation_href }}">{% else %}<div class="related-product-link">{% endif %}
              <div class="related-product-image">
                {% if block.settings.product != blank and block.settings.product.featured_image != blank %}
                  {% assign recommendation_alt = block.settings.product.featured_image.alt | default: block.settings.product.title %}
                  {{ block.settings.product.featured_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', loading: 'lazy', alt: recommendation_alt }}
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', loading: 'lazy', alt: block.settings.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="related-product-details">
                <h3>
                  {% if block.settings.title != blank %}
                    {{ block.settings.title | escape }}
                  {% elsif block.settings.product != blank %}
                    {{ block.settings.product.title | escape }}
                  {% else %}
                    Lorem ipsum
                  {% endif %}
                </h3>
                <div class="related-product-rating" aria-hidden="true">★★★★★ <span>Lorem</span></div>
                <p>
                  {% if block.settings.price != blank %}
                    {{ block.settings.price | escape }}
                  {% elsif block.settings.product != blank %}
                    {{ block.settings.product.price | money }}
                  {% else %}
                    Lorem ipsum
                  {% endif %}
                </p>
              </div>
            {% if recommendation_href != blank %}</a>{% else %}</div>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Producto en inicio",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#EEE4DA" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#4D0E13" },
    { "type": "color", "id": "accent_color", "label": "Acento", "default": "#C8A49F" },
    { "type": "text", "id": "badge_text", "label": "Etiqueta del producto", "default": "Lorem ipsum" },
    { "type": "text", "id": "product_title", "label": "Título", "default": "Lorem ipsum dolor sit amet" },
    { "type": "range", "id": "rating_score", "min": 1, "max": 5, "step": 1, "label": "Calificación", "default": 5 },
    { "type": "text", "id": "review_count", "label": "Cantidad de comentarios", "default": "Lorem comentarios" },
    { "type": "text", "id": "price_text", "label": "Precio", "default": "Lorem ipsum" },
    { "type": "text", "id": "compare_price_text", "label": "Precio anterior", "default": "Lorem ipsum" },
    { "type": "text", "id": "discount_label", "label": "Etiqueta de descuento", "default": "Lorem ipsum" },
    { "type": "richtext", "id": "introduction", "label": "Descripción", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>" },
    { "type": "text", "id": "buy_button_label", "label": "Texto del botón", "default": "Comprar Ya!" },
    { "type": "text", "id": "service_1_title", "label": "Servicio 1", "default": "Lorem ipsum" },
    { "type": "text", "id": "service_1_text", "label": "Descripción del servicio 1", "default": "Lorem ipsum dolor sit amet" },
    { "type": "text", "id": "service_2_title", "label": "Servicio 2", "default": "Lorem ipsum" },
    { "type": "text", "id": "service_2_text", "label": "Descripción del servicio 2", "default": "Lorem ipsum dolor sit amet" },
    { "type": "text", "id": "service_3_title", "label": "Servicio 3", "default": "Lorem ipsum" },
    { "type": "text", "id": "service_3_text", "label": "Descripción del servicio 3", "default": "Lorem ipsum dolor sit amet" },
    { "type": "text", "id": "details_tab_label", "label": "Pestaña de detalles", "default": "Detalles" },
    { "type": "text", "id": "details_heading", "label": "Título de detalles", "default": "Lorem ipsum dolor sit amet" },
    { "type": "richtext", "id": "details_content", "label": "Texto de detalles", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p><ul><li>Lorem ipsum dolor sit amet.</li><li>Consectetur adipiscing elit.</li><li>Sed do eiusmod tempor incididunt.</li></ul>" },
    { "type": "image_picker", "id": "details_image", "label": "Imagen de detalles" },
    { "type": "text", "id": "materials_tab_label", "label": "Pestaña de materiales", "default": "Materiales" },
    { "type": "text", "id": "materials_heading", "label": "Título de materiales", "default": "Lorem ipsum dolor sit amet" },
    { "type": "richtext", "id": "materials_content", "label": "Texto de materiales", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p><ul><li>Lorem ipsum dolor sit amet.</li><li>Consectetur adipiscing elit.</li></ul>" },
    { "type": "image_picker", "id": "materials_image", "label": "Imagen de materiales" },
    { "type": "text", "id": "reviews_eyebrow", "label": "Texto superior de comentarios", "default": "Lorem ipsum" },
    { "type": "text", "id": "reviews_heading", "label": "Título de comentarios", "default": "Comentarios de clientes" },
    { "type": "text", "id": "reviews_subheading", "label": "Subtítulo de comentarios", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
    { "type": "color", "id": "reviews_background", "label": "Fondo de comentarios", "default": "#D8C4AC" },
    { "type": "text", "id": "faq_heading", "label": "Título de preguntas", "default": "Preguntas frecuentes" },
    { "type": "color", "id": "faq_background", "label": "Fondo de preguntas", "default": "#EEE4DA" },
    { "type": "checkbox", "id": "show_related_products", "label": "Mostrar productos relacionados", "default": true },
    { "type": "text", "id": "related_heading", "label": "Título de productos relacionados", "default": "Productos relacionados" },
    { "type": "url", "id": "related_link", "label": "Enlace para ver productos" },
    { "type": "text", "id": "related_link_label", "label": "Texto del enlace", "default": "Ver todos" }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Imagen de galería",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "alt", "label": "Texto alternativo", "default": "Lorem ipsum" }
      ]
    },
    {
      "type": "review",
      "name": "Comentario",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Estrellas", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Comentario", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
        { "type": "text", "id": "author", "label": "Autor", "default": "Lorem Ipsum" }
      ]
    },
    {
      "type": "faq",
      "name": "Pregunta frecuente",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Lorem ipsum dolor sit amet?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>" }
      ]
    },
    {
      "type": "related_product",
      "name": "Producto relacionado",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto de Shopify" },
        { "type": "image_picker", "id": "image", "label": "Imagen alternativa" },
        { "type": "text", "id": "title", "label": "Título alternativo", "default": "Lorem ipsum" },
        { "type": "text", "id": "price", "label": "Precio alternativo", "default": "Lorem ipsum" },
        { "type": "url", "id": "link", "label": "Enlace alternativo" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Producto en inicio",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "related_product" },
        { "type": "related_product" },
        { "type": "related_product" }
      ]
    }
  ]
}
{% endschema %}
