<section class="section" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    <header class="section-heading">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </header>
    <div class="category-grid" style="--columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <article class="category-card" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}">{% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 761px) 33vw, 50vw', loading: 'lazy' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
            <div class="category-card-overlay">
              <span class="coming-soon-badge">{{ section.settings.badge_text | escape }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
            </div>
          {% if block.settings.link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías próximamente",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lorem ipsum dolor sit amet" },
    { "type": "text", "id": "text", "label": "Descripción", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
    { "type": "text", "id": "badge_text", "label": "Texto de la insignia", "default": "Próximamente" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columnas en escritorio", "default": 3 },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#EEE4DA" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#4D0E13" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "Nueva categoría" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Categorías próximamente", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
