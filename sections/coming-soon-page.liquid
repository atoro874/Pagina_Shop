{% assign background_image_css = 'none' %}
{% if section.settings.background_image != blank %}
  {% assign background_image_url = section.settings.background_image | image_url: width: 2400 %}
  {% assign background_image_css = 'url(' | append: background_image_url | append: ')' %}
{% endif %}
<section
  class="coming-soon-page"
  data-coming-soon
  data-redirect-seconds="{{ section.settings.redirect_seconds }}"
  data-return-url="{{ routes.root_url }}"
  style="--coming-soon-text: {{ section.settings.text_color }}; --coming-soon-background: {{ section.settings.background_color }}; --coming-soon-image: {{ background_image_css }};"
>
  <a class="coming-soon-close" href="{{ routes.root_url }}" aria-label="{{ section.settings.close_label | escape }}">×</a>
  <div class="coming-soon-content">
    {% if section.settings.eyebrow != blank %}<p class="coming-soon-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    <p
      class="coming-soon-countdown"
      data-countdown
      data-label="{{ section.settings.countdown_text | escape }}"
      aria-live="polite"
    >{{ section.settings.countdown_text | replace: '{seconds}', section.settings.redirect_seconds | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Página próximamente",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Imagen de fondo" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Título", "default": "PRÓXIMAMENTE" },
    { "type": "textarea", "id": "text", "label": "Descripción", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Estamos preparando algo especial y volverás pronto." },
    { "type": "text", "id": "countdown_text", "label": "Texto de cuenta regresiva", "default": "Volviendo al inicio en {seconds} segundos..." },
    { "type": "text", "id": "close_label", "label": "Etiqueta accesible del botón X", "default": "Volver al inicio" },
    { "type": "range", "id": "redirect_seconds", "min": 10, "max": 60, "step": 1, "unit": "s", "label": "Segundos antes de volver", "default": 10 },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#777777" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#FFFFFF" }
  ]
}
{% endschema %}
