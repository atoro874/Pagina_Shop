<header class="site-header">
  {% if section.settings.show_announcement %}
    <div class="announcement-bar" style="--announcement-background: {{ section.settings.announcement_background }}; --announcement-text: {{ section.settings.announcement_text_color }};">
      <div class="announcement-track">
        <div class="announcement-group">
          {% if section.settings.announcement_link != blank %}
            <a class="announcement-item" href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_text | escape }}</a>
          {% else %}
            <span class="announcement-item">{{ section.settings.announcement_text | escape }}</span>
          {% endif %}
          {% for repeat in (1..3) %}
            <span class="announcement-item" aria-hidden="true">{{ section.settings.announcement_text | escape }}</span>
          {% endfor %}
        </div>
        <div class="announcement-group" aria-hidden="true">
          {% for repeat in (1..4) %}
            <span class="announcement-item">{{ section.settings.announcement_text | escape }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
  <div class="header-inner">
    <a class="header-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {% assign logo_style = '--logo-width: ' | append: section.settings.logo_width | append: 'px' %}
        {{ section.settings.logo | image_url: width: 500 | image_tag: widths: '120, 180, 240, 360, 500', style: logo_style }}
      {% else %}
        {{ section.settings.logo_text | default: shop.name | escape }}
      {% endif %}
    </a>

    <nav class="header-menu" aria-label="Navegación principal">
      {% if section.settings.menu != blank %}
        <ul>
          {% for link in section.settings.menu.links %}
            {% assign normalized_link_title = link.title | downcase | strip %}
            {% unless normalized_link_title == 'blog' %}
              {% unless normalized_link_title == 'about us' %}
                {% unless normalized_link_title == 'sobre nosotros' %}
                  {% unless link.url contains '/blogs' %}
                    {% assign navigation_url = link.url %}
                    {% if normalized_link_title == 'catalogo' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% elsif normalized_link_title == 'catálogo' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% elsif normalized_link_title == 'catalog' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% elsif normalized_link_title == 'products' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% elsif normalized_link_title == 'product' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% elsif normalized_link_title == 'productos' %}
                      {% assign navigation_url = pages.proximamente.url | default: '/pages/proximamente' %}
                    {% endif %}
                    <li><a href="{{ navigation_url }}">{{ link.title | escape }}</a></li>
                  {% endunless %}
                {% endunless %}
              {% endunless %}
            {% endunless %}
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="header-actions">
      {% if section.settings.show_account %}
        <a class="header-icon-link" href="{{ routes.account_url }}" aria-label="NexuStore">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M4.5 21c.7-4.1 3.2-6.2 7.5-6.2s6.8 2.1 7.5 6.2"></path></svg>
        </a>
      {% endif %}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Mostrar franja promocional", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Texto de la franja", "default": "30% DE DESCUENTO | LOREM IPSUM DOLOR SIT AMET" },
    { "type": "url", "id": "announcement_link", "label": "Enlace de la franja" },
    { "type": "color", "id": "announcement_background", "label": "Fondo de la franja", "default": "#C8A49F" },
    { "type": "color", "id": "announcement_text_color", "label": "Texto de la franja", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "logo", "label": "Logotipo" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 300, "step": 10, "unit": "px", "label": "Ancho del logotipo", "default": 160 },
    { "type": "text", "id": "logo_text", "label": "Texto del logotipo", "default": "Mi tienda" },
    { "type": "link_list", "id": "menu", "label": "Menú de navegación" },
    { "type": "checkbox", "id": "show_account", "label": "Mostrar acceso a cuenta", "default": true }
  ]
}
{% endschema %}
