<section class="hero-slider" data-slider aria-label="{{ section.settings.accessibility_label | escape }}">
  {% for block in section.blocks %}
    {% assign slide_heading_tag = 'h2' %}
    {% assign image_loading = 'lazy' %}
    {% if forloop.first %}
      {% assign slide_heading_tag = 'h1' %}
      {% assign image_loading = 'eager' %}
    {% endif %}
    <div class="hero-slide" data-slide {{ block.shopify_attributes }}{% unless forloop.first %} hidden aria-hidden="true"{% else %} aria-hidden="false"{% endunless %} style="--hero-text-color: {{ block.settings.text_color }};">
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slide-image', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: image_loading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slide-image' }}
      {% endif %}
      <div class="hero-slide-content">
        <{{ slide_heading_tag }}>{{ block.settings.heading | escape }}</{{ slide_heading_tag }}>
        {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="hero-slide">
      <div class="hero-slide-content"><h1>{{ section.settings.empty_heading | escape }}</h1></div>
    </div>
  {% endfor %}

  {% if section.blocks.size > 1 %}
    <div class="hero-controls" aria-label="Controles del carrusel">
      <button type="button" data-slider-previous aria-label="Diapositiva anterior">&larr;</button>
      {% for block in section.blocks %}
        <button type="button" data-slider-dot aria-label="Ir a la diapositiva {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
      {% endfor %}
      <button type="button" data-slider-next aria-label="Siguiente diapositiva">&rarr;</button>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Etiqueta accesible", "default": "Destacados de la tienda" },
    { "type": "text", "id": "empty_heading", "label": "Título sin diapositivas", "default": "Añade una diapositiva destacada" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Una historia para descubrir" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Presenta tu colección con una imagen y un mensaje especial." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Descubrir" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" },
        { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#FFFFFF" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Hero slider", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
