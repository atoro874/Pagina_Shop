<section class="hero-slider" data-slider aria-label="{{ section.settings.accessibility_label | escape }}" style="--hero-background: {{ section.settings.background_color }};">
  {% for block in section.blocks %}
    {% assign slide_heading_tag = 'h2' %}
    {% assign image_loading = 'lazy' %}
    {% if forloop.first %}
      {% assign slide_heading_tag = 'h1' %}
      {% assign image_loading = 'eager' %}
    {% endif %}
    <div class="hero-story" data-slide {{ block.shopify_attributes }}{% unless forloop.first %} hidden aria-hidden="true"{% else %} aria-hidden="false"{% endunless %}>
      <div class="hero-slide" style="--hero-text-color: {{ block.settings.text_color }}; --hero-accent-color: {{ block.settings.accent_color }};">
        <div class="hero-slide-content">
          {% if block.settings.eyebrow != blank %}<p class="hero-eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
          <{{ slide_heading_tag }}>
            {{ block.settings.heading | escape }}
            {% if block.settings.heading_accent != blank %}<span>{{ block.settings.heading_accent | escape }}</span>{% endif %}
          </{{ slide_heading_tag }}>
          {% if block.settings.text != blank %}<div class="hero-description">{{ block.settings.text | escape | newline_to_br }}</div>{% endif %}
          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a class="button hero-button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {% endif %}
        </div>
        <div class="hero-slide-media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'hero-slide-image', widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 761px) 55vw, 100vw', loading: image_loading }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slide-image' }}
          {% endif %}
        </div>
      </div>

      <div class="hero-feature-strip" style="--features-background: {{ block.settings.features_background }};">
        <div class="page-width hero-feature-grid">
          {% for feature_index in (1..3) %}
            {% assign feature_icon_key = 'feature_' | append: feature_index | append: '_icon' %}
            {% assign feature_heading_key = 'feature_' | append: feature_index | append: '_heading' %}
            {% assign feature_text_key = 'feature_' | append: feature_index | append: '_text' %}
            {% assign feature_icon = block.settings[feature_icon_key] %}
            {% assign feature_heading = block.settings[feature_heading_key] %}
            {% assign feature_text = block.settings[feature_text_key] %}
            {% unless feature_heading == blank and feature_text == blank %}
              <article class="hero-feature">
                <span class="value-icon" aria-hidden="true">
                  {% case feature_icon %}
                    {% when 'leaf' %}
                      <svg viewBox="0 0 32 32"><path d="M25 5C14 5 7 9 7 18c0 5 4 8 8 8 9 0 10-10 10-21Z"></path><path d="M5 28c4-8 9-12 16-17"></path></svg>
                    {% when 'flask' %}
                      <svg viewBox="0 0 32 32"><path d="M12 4h8M14 4v9L7 25a2 2 0 0 0 2 3h14a2 2 0 0 0 2-3l-7-12V4M11 22h10"></path><path d="m13 18 2 2 4-4"></path></svg>
                    {% when 'drop' %}
                      <svg viewBox="0 0 32 32"><path d="M16 3C12 10 7 15 7 21a9 9 0 0 0 18 0c0-6-5-11-9-18Z"></path><path d="M12 22c.5 2 2 3 4 3"></path></svg>
                    {% when 'sparkle' %}
                      <svg viewBox="0 0 32 32"><path d="m16 3 2.5 9.5L28 15l-9.5 2.5L16 27l-2.5-9.5L4 15l9.5-2.5L16 3Z"></path><path d="m25 22 1.2 3.8L30 27l-3.8 1.2L25 32"></path></svg>
                    {% when 'truck' %}
                      <svg viewBox="0 0 32 32"><path d="M3 8h17v16H3zM20 14h5l4 5v5h-9z"></path><circle cx="9" cy="25" r="2"></circle><circle cx="24" cy="25" r="2"></circle></svg>
                    {% when 'shield' %}
                      <svg viewBox="0 0 32 32"><path d="M16 3 27 7v8c0 7-4.5 11-11 14C9.5 26 5 22 5 15V7l11-4Z"></path><path d="m11 16 3 3 7-7"></path></svg>
                  {% endcase %}
                </span>
                <div>
                  {% if feature_heading != blank %}<h2>{{ feature_heading | escape }}</h2>{% endif %}
                  {% if feature_text != blank %}<p>{{ feature_text | escape }}</p>{% endif %}
                </div>
              </article>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="hero-story" data-slide aria-hidden="false">
      <div class="hero-slide">
        <div class="hero-slide-content"><h1>{{ section.settings.empty_heading | escape }}</h1></div>
      </div>
    </div>
  {% endfor %}

  {% if section.blocks.size > 1 %}
    <div class="hero-controls" aria-label="Controles del carrusel">
      <button type="button" data-slider-previous aria-label="Diapositiva anterior">&larr;</button>
      <div class="hero-dots">
        {% for block in section.blocks %}
          <button type="button" data-slider-dot aria-label="Ir a la diapositiva {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {% endfor %}
      </div>
      <button type="button" data-slider-next aria-label="Siguiente diapositiva">&rarr;</button>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Etiqueta accesible", "default": "Destacados de la tienda" },
    { "type": "text", "id": "empty_heading", "label": "Título sin diapositivas", "default": "Añade una diapositiva destacada" },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#EEE4DA" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "LOREM IPSUM DOLOR SIT AMET" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Lorem ipsum dolor" },
        { "type": "text", "id": "heading_accent", "label": "Texto destacado", "default": "sit amet" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Descubrir" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" },
        { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#4D0E13" },
        { "type": "color", "id": "accent_color", "label": "Color del texto destacado", "default": "#C8A49F" },
        { "type": "color", "id": "features_background", "label": "Fondo de beneficios", "default": "#EEE4DA" },
        { "type": "select", "id": "feature_1_icon", "label": "Icono del beneficio 1", "options": [
          { "value": "leaf", "label": "Hoja" },
          { "value": "flask", "label": "Frasco" },
          { "value": "drop", "label": "Gota" },
          { "value": "sparkle", "label": "Destello" },
          { "value": "truck", "label": "Envío" },
          { "value": "shield", "label": "Protección" }
        ], "default": "leaf" },
        { "type": "text", "id": "feature_1_heading", "label": "Título del beneficio 1", "default": "Lorem ipsum" },
        { "type": "textarea", "id": "feature_1_text", "label": "Descripción del beneficio 1", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
        { "type": "select", "id": "feature_2_icon", "label": "Icono del beneficio 2", "options": [
          { "value": "leaf", "label": "Hoja" },
          { "value": "flask", "label": "Frasco" },
          { "value": "drop", "label": "Gota" },
          { "value": "sparkle", "label": "Destello" },
          { "value": "truck", "label": "Envío" },
          { "value": "shield", "label": "Protección" }
        ], "default": "flask" },
        { "type": "text", "id": "feature_2_heading", "label": "Título del beneficio 2", "default": "Dolor sit amet" },
        { "type": "textarea", "id": "feature_2_text", "label": "Descripción del beneficio 2", "default": "Sed do eiusmod tempor incididunt ut labore et dolore." },
        { "type": "select", "id": "feature_3_icon", "label": "Icono del beneficio 3", "options": [
          { "value": "leaf", "label": "Hoja" },
          { "value": "flask", "label": "Frasco" },
          { "value": "drop", "label": "Gota" },
          { "value": "sparkle", "label": "Destello" },
          { "value": "truck", "label": "Envío" },
          { "value": "shield", "label": "Protección" }
        ], "default": "drop" },
        { "type": "text", "id": "feature_3_heading", "label": "Título del beneficio 3", "default": "Consectetur" },
        { "type": "textarea", "id": "feature_3_text", "label": "Descripción del beneficio 3", "default": "Ut enim ad minim veniam, quis nostrud exercitation." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Hero slider", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
